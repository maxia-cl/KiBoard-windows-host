{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiBoard",
  "version": "2.0.1",
  "identifier": "com.kiboard.host",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KiBoard Host",
        "width": 960,
        "height": 640,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/maxia-cl/KiBoard-windows-host/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBOTEyMTlFQzNFMzg1NTkKUldSWmhlUERuaUdSeXNBVU00WjdtM1dpOGR6aGVlN0hwaFlyeUtaZlJZdVlTSUdKUWIwTE9vTUcK"
    }
  }
}
