# Normalize to LF in the repository; check out native on Windows.
* text=auto

# Always LF: these break when checked out with CRLF.
*.sh            text eol=lf
gradlew         text eol=lf
*.rs            text eol=lf
*.dart          text eol=lf
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf

# Always CRLF: Windows-only tooling.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary — never diff, never convert.
*.png           binary
*.jpg           binary
*.ico           binary
*.icns          binary
*.ttf           binary
*.woff2         binary
*.keystore      binary
*.jks           binary

# Generated: collapse in diffs and exclude from language stats.
*.g.dart        linguist-generated=true
*.g.css         linguist-generated=true
Cargo.lock      linguist-generated=true
pubspec.lock    linguist-generated=true
